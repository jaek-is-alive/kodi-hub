<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<addons>
<addon id="plugin.video.jacobshub" name="Jacob's Hub" version="1.0.0" provider-name="jacob">
    <requires>
        <import addon="xbmc.python" version="3.0.0"/>
    </requires>
    <extension point="xbmc.python.pluginsource" library="default.py">
        <provides>video</provides>
    </extension>
    <extension point="xbmc.addon.metadata">
        <summary lang="en_GB">One hub for everything: Umbrella, The Loop, search and debrid tools.</summary>
        <description lang="en_GB">Personal launcher addon. Deep-links into Umbrella and The Loop, adds one-tap search, AllDebrid/TorBox connect buttons, and CocoScrapers auto-configuration. Edit resources/menu.json to change the menus.</description>
        <platform>all</platform>
        <license>MIT</license>
        <assets>
            <icon>icon.png</icon>
            <fanart>fanart.png</fanart>
        </assets>
        <news>v1.0.0 initial release</news>
    </extension>
</addon>
<addon id="repository.jacobshub" name="Jacob's Hub Repository" version="1.0.0" provider-name="jacob">
    <extension point="xbmc.addon.repository" name="Jacob's Hub Repository">
        <dir>
            <info compressed="false">https://jaek-is-alive.github.io/kodi-hub/addons.xml</info>
            <checksum>https://jaek-is-alive.github.io/kodi-hub/addons.xml.md5</checksum>
            <datadir zip="true">https://jaek-is-alive.github.io/kodi-hub/</datadir>
        </dir>
    </extension>
    <extension point="xbmc.addon.metadata">
        <summary lang="en_GB">Personal repository serving Jacob's Hub.</summary>
        <description lang="en_GB">Auto-update channel for plugin.video.jacobshub, served from GitHub.</description>
        <platform>all</platform>
        <license>MIT</license>
        <assets>
            <icon>icon.png</icon>
            <fanart>fanart.png</fanart>
        </assets>
    </extension>
</addon>
</addons>
