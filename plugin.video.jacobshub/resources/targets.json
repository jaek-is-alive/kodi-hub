{
  "_comment": "All upstream addon IDs, URLs and actions live here. Verified against plugin.video.umbrella 6.7.79, script.module.cocoscrapers 1.0.32, plugin.video.the-loop 8.0b (2026-07-06). Fix here if upstream renames things.",
  "ids": {
    "umbrella": "plugin.video.umbrella",
    "cocoscrapers": "script.module.cocoscrapers",
    "theloop": "plugin.video.the-loop"
  },
  "search": {
    "movies": {
      "title": "Search Movies (Umbrella)",
      "url": "plugin://plugin.video.umbrella/?action=movieSearchterm&name={query}"
    },
    "tv": {
      "title": "Search TV Shows (Umbrella)",
      "url": "plugin://plugin.video.umbrella/?action=tvSearchterm&name={query}"
    },
    "loop": {
      "title": "Search Live Sports (The Loop)",
      "url": "plugin://plugin.video.the-loop/ls3arch3/search/{query}",
      "quote": "path"
    }
  },
  "auth": {
    "alldebrid": "plugin://plugin.video.umbrella/?action=ad_Authorize",
    "alldebrid_revoke": "plugin://plugin.video.umbrella/?action=ad_Revoke",
    "torbox": "plugin://plugin.video.umbrella/?action=tb_Authorize",
    "torbox_revoke": "plugin://plugin.video.umbrella/?action=tb_Revoke",
    "realdebrid": "plugin://plugin.video.umbrella/?action=rd_Authorize",
    "realdebrid_revoke": "plugin://plugin.video.umbrella/?action=rd_Revoke",
    "premiumize": "plugin://plugin.video.umbrella/?action=pm_Authorize",
    "premiumize_revoke": "plugin://plugin.video.umbrella/?action=pm_Revoke",
    "trakt": "plugin://plugin.video.umbrella/?action=traktAuth",
    "trakt_revoke": "plugin://plugin.video.umbrella/?action=traktRevoke"
  },
  "accounts": {
    "alldebrid": "plugin://plugin.video.umbrella/?action=ad_AccountInfo",
    "torbox": "plugin://plugin.video.umbrella/?action=tb_AccountInfo",
    "realdebrid": "plugin://plugin.video.umbrella/?action=rd_AccountInfo",
    "premiumize": "plugin://plugin.video.umbrella/?action=pm_AccountInfo"
  },
  "maintenance": {
    "umbrella_clear_all": "plugin://plugin.video.umbrella/?action=cache_clearAll",
    "umbrella_clear_providers": "plugin://plugin.video.umbrella/?action=cache_clearSources",
    "umbrella_force_trakt_sync": "plugin://plugin.video.umbrella/?action=tools_forceTraktSync",
    "umbrella_view_log": "plugin://plugin.video.umbrella/?action=tools_viewLogFile",
    "coco_settings": "plugin://script.module.cocoscrapers/?action=CocoScrapersSettings",
    "coco_enable_all_torrents": "plugin://script.module.cocoscrapers/?action=toggleAllTorrent&setting=true",
    "coco_reset_defaults": "plugin://script.module.cocoscrapers/?action=Defaults",
    "loop_clear_cache": "plugin://plugin.video.the-loop/clear_cache"
