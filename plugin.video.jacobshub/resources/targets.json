      "setting": "alldebridtoken"
    },
    "TorBox": {
      "setting": "torboxtoken"
    },
    "Real-Debrid": {
      "setting": "realdebridtoken"
    },
    "Premiumize": {
      "setting": "premiumizetoken"
    },
    "Trakt": {
      "setting": "trakt.user.token"
    }
  },
  "setup": [
    {
      "addon_id": "plugin.video.umbrella",
      "label": "Umbrella (movies/TV)"
    },
    {
      "addon_id": "script.module.cocoscrapers",
