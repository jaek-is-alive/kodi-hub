  "search": [
    {
      "label": "Search Movies\u2026",
      "hub": "search",
      "params": {
        "kind": "movies"
      },
      "requires": "plugin.video.umbrella"
    },
    {
      "label": "Search TV Shows\u2026",
      "hub": "search",
      "params": {
        "kind": "tv"
      },
      "requires": "plugin.video.umbrella"
    },
    {
      "label": "Search Live Sports\u2026",
      "hub": "search",
      "params": {
        "kind": "loop"
      },
      "requires": "plugin.video.the-loop"
    },
    {
      "label": "Umbrella Search Hub",
      "path": "plugin://plugin.video.umbrella/?action=tools_searchNavigator",
      "requires": "plugin.video.umbrella"
    },
    {
      "label": "The Loop Search Menu",
      "path": "plugin://plugin.video.the-loop/get_list/https://loopaddon.uk/files/k19/searchmain.json",
      "requires": "plugin.video.the-loop"
    }
  ],
  "tools": [
    {
      "label": "[B]\u2699 Setup \u2014 install Umbrella, CocoScrapers & The Loop[/B]",
      "hub": "setup",
      "plot": "Installs the backend add-ons (and their dependencies) from this repo, then offers to wire CocoScrapers into Umbrella."
    },
    {
      "label": "[B]Connect AllDebrid[/B]",
      "run": "auth.alldebrid",
      "requires": "plugin.video.umbrella",
      "plot": "Starts Umbrella's AllDebrid device-code auth flow."
    },
    {
      "label": "[B]Connect TorBox[/B]",
      "run": "auth.torbox",
      "requires": "plugin.video.umbrella",
      "plot": "Starts Umbrella's TorBox auth flow."
    },
    {
      "label": "Connect Trakt",
      "run": "auth.trakt",
      "requires": "plugin.video.umbrella"
    },
    {
      "label": "Connect Real-Debrid",
      "run": "auth.realdebrid",
      "requires": "plugin.video.umbrella"
    },
    {
      "label": "Connect Premiumize",
      "run": "auth.premiumize",
      "requires": "plugin.video.umbrella"
    },
    {
      "label": "Status \u2014 what's installed / connected",
      "hub": "status"
    },
    {
      "label": "[B]Auto-configure CocoScrapers[/B] (wire into Umbrella)",
      "hub": "preset",
      "params": {
        "id": "wire_cocoscrapers"
      },
      "requires": "plugin.video.umbrella",
      "plot": "Points Umbrella's external provider at script.module.cocoscrapers and sets a sane scrape timeout."
    },
    {
      "label": "Apply recommended CocoScrapers providers",
      "hub": "preset",
      "params": {
        "id": "coco_recommended"
      },
      "requires": "script.module.cocoscrapers"
    },
    {
      "label": "AllDebrid account info",
      "run": "accounts.alldebrid",
      "requires": "plugin.video.umbrella"
    },
    {
      "label": "TorBox account info",
      "run": "accounts.torbox",
      "requires": "plugin.video.umbrella"
    },
    {
      "label": "Umbrella settings",
      "hub": "settings",
      "params": {
        "id": "plugin.video.umbrella"
      }
    },
    {
      "label": "CocoScrapers settings",
      "run": "maintenance.coco_settings",
      "requires": "script.module.cocoscrapers"
    },
    {
      "label": "The Loop settings",
      "hub": "settings",
      "params": {
        "id": "plugin.video.the-loop"
      }
    },
    {
      "label": "Force Trakt sync (Umbrella)",
      "run": "maintenance.umbrella_force_trakt_sync",
      "requires": "plugin.video.umbrella"
    },
    {
      "label": "Clear Umbrella provider cache",
      "run": "maintenance.umbrella_clear_providers",
      "requires": "plugin.video.umbrella"
    },
    {
      "label": "Clear Umbrella all caches",
      "run": "maintenance.umbrella_clear_all",
      "requires": "plugin.video.umbrella"
    },
    {
      "label": "Clear The Loop cache",
      "run": "maintenance.loop_clear_cache",
      "requires": "plugin.video.the-loop"
    }
  ]
}
